import 'package:flutter/material.dart';
import 'package:planter_app/Models/Plant';
import 'package:planter_app/Screens/AddEdit';
import 'package:intl/intl.dart';

class PlantDetailsScreen extends StatefulWidget{
  @override
  _PlantDetailsScreenState createState() => _PlantDetailsScreenState();
}

class _PlantDetailsScreenState extends State<PlantDetailsScreen>{
  late Plant plant;

  @override
  void didChangeDependencies(){
    super.didChangeDependencies();
    plant = ModalRoute.of(context)!.settings.arguments as Plant;
  }


  @override
  Widget build(BuildContext context) {
    String formattedDate = DateFormat('MM/dd/yyyy').format(plant.lastWater);
    return Scaffold(
      appBar: AppBar(
        title: Text(
          plant.name.toUpperCase(),
          style: TextStyle(fontWeight: FontWeight.bold),
          ),
      ),
      body: Padding(
        padding: EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Plant Name: ',
              style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),            
              ),
            SizedBox(height: 8),
            Text(
              plant.name.toUpperCase(),
              style: TextStyle(fontSize: 20, color: Colors.green),
            ),
            SizedBox(height: 8),
            Text(
              'Last Watered: ',
              style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
            ),
            SizedBox(height: 8),
            Row(
              children: [
            Text(
              formattedDate,
              style: TextStyle(fontSize: 20, color: Colors.green),
            ),
            SizedBox(height: 8),
            IconButton(
              icon: Icon(Icons.water_damage, color: Colors.blue),
              onPressed: () async {
                setState((){
                  plant.lastWater = DateTime.now();
                });
              },
              tooltip: 'Water Plant',
            ),
              ],
            ),
            SizedBox(height: 8),
            Text(
              'Interval: ',
              style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
            ),
            SizedBox(height: 8),
            Text(
              'Every ${plant.interval} days',
              style: TextStyle(fontSize: 20, color: Colors.green),
            ),
          ],
        ),
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () async {
          final plantData = await Navigator.pushNamed(
            context,
            '/addEdit',
            arguments: plant,
          ) as Map<String, String>?;
          if (plantData != null) {
            setState((){
              plant = Plant(
                name: plantData['name']!,
                interval: int.tryParse(plantData['interval']!) ?? 0,
                lastWater: plant.lastWater,
                imageURL: plantData['image'] ?? '',
              );
            });
            Navigator.pop(context, plantData);
          }
        },
        child: Icon(Icons.edit),
        tooltip: 'Edit',
      ),
    );
  }
}