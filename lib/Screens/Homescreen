import 'package:flutter/material.dart';
import 'package:planter_app/Models/Plant';
import 'dart:io';
import 'package:image_picker/image_picker.dart';
import 'package:intl/intl.dart';

class HomeScreen extends StatefulWidget {
  @override
  _HomescreenState createState() => _HomescreenState();
}

class _HomescreenState extends State<HomeScreen>{
  List<Plant> plants = [];
  
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text(
          'My Plants',
          style: TextStyle(fontWeight: FontWeight.bold),
        ),        
      ),
      body: plants.isEmpty
      ? Center(
        child: Text(
          'No plants added. Tap the + button to add a plant.'))
      :ListView.builder(
        itemCount: plants.length,
        itemBuilder: (context, index) {
          final plant = plants[index];
          String formattedDate = DateFormat('MM/dd/yyyy').format(plant.lastWater);
          return GestureDetector(
            onTap: () {
              Navigator.pushNamed(
                context,
                '/plantDetails',
                arguments: plant,
              );
            },
            child: Card(
              margin: EdgeInsets.symmetric(vertical: 10, horizontal: 16),
              elevation: 4.0,
              child: Padding(
                padding: EdgeInsets.all(16.0),
                child: Row(
                  children: [
                    plant.imageURL.isNotEmpty
                    ?Image.file(
                      File(plant.imageURL),
                      width: 50,
                      height: 50,
                    )
                    :Icon(Icons.image, size: 50),
                    SizedBox(width: 16),
                    Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          plant.name.toUpperCase(),
                          style: TextStyle(
                            fontSize: 20, 
                            fontWeight: FontWeight.bold
                            ),
                        ),
                        SizedBox(height: 4),
                        Text(
                          'Water Every ${plant.interval} days',
                          style: TextStyle(
                            fontSize: 16, 
                            color: Colors.grey
                            ),
                        ),
                        SizedBox(height: 4),
                        Text(
                          'Last Watered: ${formattedDate}',
                          style: TextStyle(
                            fontSize: 16,
                            color: Colors.grey
                          ),
                        ),
                      ],
                    ),
                    Spacer(),
                    IconButton(
                      icon: Icon(Icons.water_damage, color: Colors.blue),
                      onPressed: () async {
                        setState((){
                          plant.lastWater = DateTime.now();
                        });
                      },
                      tooltip: 'Water Plant',
                    ),
                    IconButton(
                      icon: Icon(Icons.edit),
                      onPressed: () async {
                        final plantData = await Navigator.pushNamed(
                          context, 
                          '/addEdit',
                          arguments: plant,
                        ) as Map<String, String>?;
                        if (plantData != null){
                          setState((){
                            plants[index] = Plant(
                              name: plantData['name']?.isNotEmpty == true ? plantData['name']! : plants[index].name,
                              interval: int.tryParse(plantData['interval'] ?? '') ?? plants[index].interval,
                              lastWater: plants[index].lastWater,
                              imageURL: plantData['image']?.isNotEmpty == true ? plantData['image']! : plants[index].imageURL,
                            );
                          });
                        }
                      },
                      tooltip: 'Edit',
                    ),
                    IconButton(
                      icon: Icon(Icons.delete, color: Colors.red),
                      onPressed: () async {
                        final confirmation = await showDialog<bool>(
                          context: context,
                          builder: (context) => AlertDialog(
                            title: Text('Delete Plant?'),
                            content: Text('Are you sure you want to delete this plant?'),
                            actions: [
                              TextButton(
                                onPressed: () => Navigator.pop(context, false),
                                child: Text('Cancel'),
                              ),
                              TextButton(
                                onPressed: () => Navigator.pop(context, true),
                                child: Text('Delete', style: TextStyle(color: Colors.red)),
                              ),
                            ],
                          ),
                        ) ?? false;
                        if (confirmation) {
                          setState((){
                            plants.removeAt(index);
                          });
                        }
                      },
                      tooltip: 'Delete',
                    ),
                  ],
                ),
              ),
            ),
          );
        },
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () async {
          final plantData = await _showPlantDialog(context);

          if (plantData != null){
          setState((){
            plants.add(Plant(
              name: plantData['name']!,
              interval: int.tryParse(plantData['interval']!) ?? 0,
              lastWater: DateTime.now(),
              imageURL: plantData['image'] ?? '',
            ));
          });
          }
        },
        child: Icon(Icons.add),
        tooltip: 'Add Plant',
      ),
    );
  }

  Future<Map<String,String>?> _showPlantDialog(BuildContext context, {Plant? plant}) async {
    final TextEditingController plantNameController = TextEditingController(text: plant?.name);
    final TextEditingController plantIntervalController = TextEditingController(text: plant?.interval.toString());    
    final ImagePicker _picker = ImagePicker();
    File? _image = plant?.imageURL.isNotEmpty == true ? File(plant!.imageURL) : null;

    Future<void> _pickImage(ImageSource source, StateSetter setState) async {
      final XFile? pickedFile = await _picker.pickImage(source: source);
      if (pickedFile != null) {
        setState((){
          _image = File(pickedFile.path);
        });
      }
    }

    

    return showDialog<Map<String, String>>(
      context: context,
      builder: (context) {
        return StatefulBuilder(
          builder: (context, setState){
        return AlertDialog(
          title: Text(plant == null ? 'Add New Plant' : 'Edit Plant'),
          content: Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              TextField(
                controller: plantNameController,
                decoration: InputDecoration(hintText: 'Plant Name'),
              ),
              SizedBox(height: 8),
              TextField(
                controller: plantIntervalController,
                decoration: InputDecoration(hintText: 'Watering Interval (days)'),
                keyboardType: TextInputType.number,
              ),
              SizedBox(height: 8),
              _image == null
              ? Text('No image selected.')
              : Image.file(
                _image!, 
                width: 100,
                height: 100
                ),
              Row(
                children: [
                  TextButton(
                    onPressed: () => _pickImage(ImageSource.gallery, setState),
                    child: Text('Pick Image'),
                  ),
                  TextButton(
                    onPressed: () => _pickImage(ImageSource.camera, setState),
                    child: Text('Take Photo'),
                  ),
                ],
              ),
            ],
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(context, {
                  'name': plantNameController.text,
                  'interval': plantIntervalController.text,
                  'image': _image?.path ?? '',
                });
              },
              child: Text('OK'),
            ),
          ],
        );
      },
    );
      },
    );
  }
}